{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "ecpg",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#types"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#execsql"
		},
		{
			"include": "#support"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.ecpg",
					"match": "\\b(if|else|for|while|return|switch|case|break|continue)\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"match": "\\b(int|char|float|double|void|long|short|unsigned|signed|struct|enum)\\b",
					"name": "storage.type.ecpg"
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"begin": "/\\*",
					"end": "\\*/",
					"name": "comment.block.ecpg"
				},
				{
					"match": "//.*$",
					"name": "comment.line.double-slash.ecpg"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.ecpg",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.ecpg",
					"match": "\\\\."
				}
			]
		},
		"execsql": {
			"name": "source.execsql.ecpg",
			"begin": "EXEC\\s+SQL\\s+",
			"beginCaptures": {
				"0": {
					"name": "keyword.execsql.ecpg"
				}
			},
			"end": ";",
			"patterns": [
				{
					"name": "variable.execsql.ecpg",
					"match": "(?<=[^:]:)\\w+"
				},
				{
					"name": "variable.execsql.sqlca.ecpg",
					"match": "(?<=EXEC\\s+SQL\\s+INCLUDE\\s+)sqlca"
				},
				{
					"name": "variable.execsql.declare.ecpg",
					"match": "(?<=EXEC\\s+SQL\\s+DECLARE\\s+)\\w+"
				},
				{
					"name": "variable.execsql.cursor.open.ecpg",
					"match": "(?<=EXEC\\s+SQL\\s+OPEN\\s+)\\w+"
				},
				{
					"name": "variable.execsql.cursor.ref.ecpg",
					"match": "(?<=EXEC\\s+SQL\\s+FETCH\\s+NEXT\\s+FROM\\s+)\\w+"
				},
				{
					"name": "variable.execsql.cursor.close.ecpg",
					"match": "(?<=EXEC\\s+SQL\\s+CLOSE\\s+)\\w+"
				},
				{
					"name": "variable.execsql.connection.set.ecpg",
					"match": "(?<=EXEC\\s+SQL\\s+SET\\s+CONNECTION\\s+)\\w+"
				},
				{
					"match": "(?<=EXEC\\s+SQL\\s+CONNECT\\s+TO\\s+)([^:]+?)(\\s+AS\\s+)([^:]+?)(\\s+USER\\s+)([^:]+?)(\\s+USING\\s+)([^:]+?)(?=;)",
					"captures": {
						"1": {
							"name": "string.execsql.connect.database.ecpg"
						},
						"3": {
							"name": "string.execsql.connect.connection.ecpg"
						},
						"5": {
							"name": "string.execsql.connect.user.ecpg"
						},
						"7": {
							"name": "string.execsql.connect.password.ecpg"
						}
					}
				},
				{
					"match": "(?<=EXEC\\s+SQL\\s+CONNECT\\s+TO\\s+)([^:]+?)(\\s+AS\\s+)([^:]+?)(\\s+USER\\s+)([^:]+?)(\\s+IDENTIFIED\\s+BY\\s+)([^:]+?)(?=;)",
					"captures": {
						"1": {
							"name": "string.execsql.connect.database.ecpg"
						},
						"3": {
							"name": "string.execsql.connect.connection.ecpg"
						},
						"5": {
							"name": "string.execsql.connect.user.ecpg"
						},
						"7": {
							"name": "string.execsql.connect.password.ecpg"
						}
					}
				},
				{
					"match": "(?<=EXEC\\s+SQL\\s+CONNECT\\s+TO\\s+)([^:]+?)(\\s+AS\\s+)([^:]+?)(\\s+USER\\s+)([^:]+?)(?=;)",
					"captures": {
						"1": {
							"name": "string.execsql.connect.database.ecpg"
						},
						"3": {
							"name": "string.execsql.connect.connection.ecpg"
						},
						"5": {
							"name": "string.execsql.connect.user.ecpg"
						}
					}
				},
				{
					"match": "(?<=EXEC\\s+SQL\\s+CONNECT\\s+TO\\s+)([^:]+?)(\\s+AS\\s+)([^:]+?)(?=;)",
					"captures": {
						"1": {
							"name": "string.execsql.connect.database.ecpg"
						},
						"3": {
							"name": "string.execsql.connect.connection.ecpg"
						}
					}
				},
				{
					"match": "(?<=EXEC\\s+SQL\\s+CONNECT\\s+TO\\s+)([^:]+?)(?=;)",
					"captures": {
						"1": {
							"name": "string.execsql.connect.database.ecpg"
						}
					}
				},
				{
					"include": "#types"
				}
			]
		},
		"support": {
			"patterns": [
				{
					"name": "support.include.ecpg",
					"match": "#.*$"
				}
			]
		}
	},
	"scopeName": "source.ecpg"
}